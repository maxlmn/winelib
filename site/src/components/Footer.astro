---
// Starlight's footer (pagination), then the licence and the data's credits on every page
import Default from '@astrojs/starlight/components/Footer.astro';
import Version from './Version.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default />
<p class="licence">
	WineLib <Version /> ·
	open source (<a href="https://github.com/maxlmn/winelib/blob/main/LICENSE">MIT</a>). Its maps and
	reference data come from open sources, each with its own licence: <a href={`${base}/about/data/`}>About the data</a>.
</p>

<style>
	.licence {
		margin-top: 2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
