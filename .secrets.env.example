# Copy to .secrets.env (git-ignored) next to run.py, or in the data folder, and fill in what you use; everything here is optional.

# The database, when not the app's own SQLite file (data/winelib.db), e.g. postgresql://user:password@host/winelib
DB_URL=

# WineLabs.ai: market prices by LWIN (the bottle page's button, Maintenance › Market prices)
WINELABS_API_KEY=

# Anthropic (console.anthropic.com): the bottle form's Fill from photos, the labels read by Claude (the photos are
# sent to Anthropic, billed to this key). LABEL_MODEL: another Claude model than claude-opus-5-5, if you like
ANTHROPIC_API_KEY=
LABEL_MODEL=

# Esri (location.arcgis.com, a free ArcGIS Location Platform account): the satellite view outside France, Esri's
# World Imagery. Your browser uses the key, so limit it on Esri's site to World Imagery and your WineLib's address.
# Without it, the satellite view is IGN's photos in France and the plain map elsewhere.
ESRI_API_KEY=

# Bordeaux Index LiveTrade API (an approved access, https://api.biwine.com/swagger-ui): the cellar's Bordeaux Index view
BI_EMAIL=
BI_PASSWORD=
BI_SALES_LEDGER=
BI_PURCHASE_LEDGER=
