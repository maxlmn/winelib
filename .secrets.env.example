# Copy to .secrets.env (git-ignored) next to run.py and fill in what you use; everything here is optional.

# The database, when not the app's own SQLite file (data/winelib.db), e.g. postgresql://user:password@host/winelib
DB_URL=

# WineLabs.ai: market prices by LWIN (the bottle page's button, Maintenance › Market prices)
WINELABS_API_KEY=

# Anthropic (console.anthropic.com): the bottle form's Fill from photos, the labels read by Claude (the photos are
# sent to Anthropic, billed to this key). LABEL_MODEL: another Claude model than claude-opus-5-5, if you like
ANTHROPIC_API_KEY=
LABEL_MODEL=

# Bordeaux Index LiveTrade API (an approved access, https://api.biwine.com/swagger-ui): the cellar's Bordeaux Index view
BI_EMAIL=
BI_PASSWORD=
BI_SALES_LEDGER=
BI_PURCHASE_LEDGER=
